[Desktop Entry]
Type=Application
Name=Throtl (Classic)
Comment=Classic GTK4 GUI for Throtl (the new dashboard is the 'Throtl' entry)
GenericName=Network Bandwidth Manager
NoDisplay=true
Categories=Network;System;Utility;
Keywords=bandwidth;limit;qos;network;traffic;
