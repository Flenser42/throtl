[Unit]
Description=Throtl - per-application bandwidth limits and QoS (TrafficToll backend)
Documentation=file:/opt/throtl/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is required: tc, cgroups, modprobe and nethogs need privileged access.
User=root
# Deliberately NO Group=: the service runs as root; the socket is set to
# root:throtl with mode 0660 at runtime (Daemon._secure_socket). install.sh
# creates the 'throtl' group and adds the invoking user.
# WorkingDirectory=/opt/throtl so `python -m throtl.*` finds the package
# (systemd would otherwise start in "/").
WorkingDirectory=/opt/throtl
# systemd creates /run/throtl (socket + generated YAML + tt log).
RuntimeDirectory=throtl
RuntimeDirectoryMode=0755
# Config directory (the daemon persists limits/priorities here).
Environment=THROTL_CONFIG_DIR=/etc/throtl
# Runtime directory for generated YAML + tt log (NOT /tmp).
Environment=THROTL_RUN_DIR=/run/throtl
# Set PATH explicitly so nethogs/ip/tc are found even with a minimal service
# PATH (a safeguard, in addition to absolute path resolution).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Preload the ifb module: TrafficToll needs it for download shaping.
ExecStartPre=-/sbin/modprobe ifb numifbs=1
# IMPORTANT: `-u` => unbuffered stdout/stderr, otherwise the daemon messages
# ("Monitor error: ...", "Engine error: ...") are NOT visible in the journal.
ExecStart=/opt/throtl/venv/bin/python -u -m throtl.daemon --foreground \
    --socket /run/throtl/daemon.sock \
    --tt-command /opt/throtl/venv/bin/tt
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2

# Deliberately NO additional sandboxing and NO capability restriction:
#  * CapabilityBoundingSet strips the file capabilities of /usr/bin/nethogs
#    (cap_sys_ptrace, cap_dac_read_search) -> nethogs cannot read /proc/<pid>
#    and reports no processes.
#  * ProtectSystem=strict made /run writable only via ReadWritePaths and could
#    prevent writing the generated YAML.
# A root service that must drive tc/modprobe/nethogs needs these privileges.

[Install]
WantedBy=multi-user.target
