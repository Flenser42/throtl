[Unit]
Description=Throtl - NetLimiter-artige Bandbreiten-Limits und QoS (TrafficToll-Backend)
Documentation=file:/opt/netlimiter-clone/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root ist erforderlich: tc/cgroups/nethogs brauchen privilegierte Rechte.
User=root
# WorkingDirectory muss /opt/netlimiter-clone sein, damit `python -m throtl.*`
# das Paket findet (systemd startet sonst in "/", wo 'throtl' nicht importiert
# werden kann -> ImportError -> Exit 1 -> Restart-Loop). Alternativ waere ein
# PYTHONPATH; WorkingDirectory ist hier am klarsten.
WorkingDirectory=/opt/netlimiter-clone
# systemd legt /run/netlimiter-clone an und raeumt es bei Stopp auf.
RuntimeDirectory=netlimiter-clone
# THROTL_CONFIG_DIR=/etc/netlimiter-clone: Daemon persistiert die gesetzten
# Limits/Prioritaeten hier (root-writierbar). Die GUI liest die Config über die
# Unix-Socket-API get_config — nie direkt aus der Datei.
Environment=THROTL_CONFIG_DIR=/etc/netlimiter-clone
# Laufzeitverzeichnis fuer generierte YAML + tt-Log. Vorher lag die YAML in /tmp,
# wo sie durch Rechte-Kollisionen nicht schreibbar war (EACCES).
Environment=THROTL_RUN_DIR=/run/netlimiter-clone
# Trusted CAP-NF-Administration/CAP_SYS_MODULE fuer tc + modprobe ifb explizit geben,
# falls die Boot-Capability-Limits eingeschraenkt sind. root-Prozess erbt vollen Satz,
# aber das macht es explizit.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_MODULE CAP_NET_RAW CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_MODULE
ExecStartPre=-/sbin/modprobe ifb numifbs=1
ExecStart=/opt/netlimiter-clone/venv/bin/python -m throtl.daemon --foreground \
    --socket /run/netlimiter-clone/daemon.sock \
    --tt-command /opt/netlimiter-clone/venv/bin/tt
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2
# Root: noettg i. a. NoNewPrivileges=false (default). tc/cgroups brauchen volle root.
NoNewPrivileges=false
# ProtectSystem=strict macht /usr,/boot,/etc readonly; ReadWritePaths kehrt /etc/netlimiter-clone um.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/netlimiter-clone /etc/netlimiter-clone
# NICHT diese Restriktionen setzen — sie blockierten tc/modprobe:
# ProtectKernelTunables / ProtectKernelModules / PrivateDevices / ProtectCPUFreq
ProtectKernelTunables=false
ProtectKernelModules=false
PrivateDevices=false

[Install]
WantedBy=multi-user.target
