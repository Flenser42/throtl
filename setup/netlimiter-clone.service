[Unit]
Description=Throtl - NetLimiter-artige Bandbreiten-Limits und QoS (TrafficToll-Backend)
Documentation=file:/opt/netlimiter-clone/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root ist erforderlich: tc, cgroups, modprobe und nethogs brauchen privilegierte Rechte.
User=root
# WorkingDirectory=/opt/netlimiter-clone, damit `python -m throtl.*` das Paket
# findet (systemd startet sonst in "/").
WorkingDirectory=/opt/netlimiter-clone
# systemd legt /run/netlimiter-clone an (Socket + generierte YAML + tt-Log).
RuntimeDirectory=netlimiter-clone
RuntimeDirectoryMode=0755
# Config-Verzeichnis (daemon persistiert Limits/Prioritaeten hier).
Environment=THROTL_CONFIG_DIR=/etc/netlimiter-clone
# Laufzeitverzeichnis fuer generierte YAML + tt-Log (NICHT /tmp).
Environment=THROTL_RUN_DIR=/run/netlimiter-clone
# PATH explizit setzen, damit nethogs/ip/tc auch bei minimalem Service-PATH
# gefunden werden (Absicherung, zusaetzlich zur absoluten Pfadaufloesung).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ifb-Modul vorladen: TrafficToll braucht es fuer das Download-Shaping.
ExecStartPre=-/sbin/modprobe ifb numifbs=1
# WICHTIG: `-u` => stdout/stderr unbuffered, sonst sind die Daemon-Meldungen
# ("Monitor-Fehler: ...", "Engine-Fehler: ...") im Journal NICHT sichtbar.
ExecStart=/opt/netlimiter-clone/venv/bin/python -u -m throtl.daemon --foreground \
    --socket /run/netlimiter-clone/daemon.sock \
    --tt-command /opt/netlimiter-clone/venv/bin/tt
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=2

# Bewusst KEIN zusätzliches Sandboxing und KEINE Capability-Beschraenkung:
#  * CapabilityBoundingSet kappt die File-Capabilities von /usr/bin/nethogs
#    (cap_sys_ptrace, cap_dac_read_search) -> nethogs kann /proc/<pid> nicht
#    lesen und liefert keine Prozesse.
#  * ProtectSystem=strict machte /run nur ueber ReadWritePaths beschreibbar und
#    konnte das Schreiben der generierten YAML verhindern.
# Ein root-Service, der tc/modprobe/nethogs steuern muss, braucht diese Rechte.

[Install]
WantedBy=multi-user.target
