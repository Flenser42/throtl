#!/usr/bin/env python3
"""Throtl CLI: control the daemon without the GUI (test limits, status, live monitor)."""
import os
import sys

# realpath resolves symlinks (e.g. /usr/local/bin/throtl-cli -> /opt/throtl/bin),
# so the project directory lands in sys.path correctly regardless of how it is invoked.
_PROJECT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _PROJECT_DIR not in sys.path:
    sys.path.insert(0, _PROJECT_DIR)

from throtl.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
