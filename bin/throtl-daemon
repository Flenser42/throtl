#!/usr/bin/env python3
"""Throtl daemon (root required: tc/cgroups/nethogs).

Installation: setup/install.sh | Manual: sudo ./bin/throtl-daemon --foreground
"""
import os
import sys

# realpath resolves symlinks so the project directory (e.g. /opt/throtl)
# lands in sys.path correctly, regardless of how the daemon is invoked.
_PROJECT_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _PROJECT_DIR not in sys.path:
    sys.path.insert(0, _PROJECT_DIR)

from throtl.daemon import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
